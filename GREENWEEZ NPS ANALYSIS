-- ============================================================
-- STEP 1: DATA EXPLORATION
-- ============================================================

-- View full table structure
SELECT *
FROM course14.gwz_nps;

-- Check if orders_id is a primary key
SELECT DISTINCT orders_id
FROM course14.gwz_nps;

-- Order by date and orders_id to spot duplicates
SELECT *
FROM course14.gwz_nps
ORDER BY date_date DESC, orders_id DESC;
-- Result: order 970720 appears twice → 1 duplicate found


-- ============================================================
-- STEP 2: DATA CLEANING & DEDUPLICATION
-- ============================================================

-- Create a working copy (staging) — never modify raw data
CREATE OR REPLACE TABLE course14.gwz_nps_deduplicated AS
SELECT *
FROM course14.gwz_nps;

-- Remove duplicates using SELECT DISTINCT
-- Note: Works here because the duplicate row is 100% identical.
-- For partial duplicates, ROW_NUMBER() OVER (PARTITION BY orders_id) is safer.
SELECT DISTINCT *
FROM course14.gwz_nps
ORDER BY date_date DESC, orders_id DESC;

-- Create final clean table (analysis-ready)
CREATE OR REPLACE TABLE course14.gwz_nps_clean AS
SELECT DISTINCT *
FROM course14.gwz_nps;

-- Validate: total_rows should equal distinct_orders
SELECT
  COUNT(*) AS total_rows,
  COUNT(DISTINCT orders_id) AS distinct_orders
FROM course14.gwz_nps_clean;
-- Result: 6294 = 6294 ✅

-- Table architecture:
-- gwz_nps              → raw (Bronze)
-- gwz_nps_deduplicated → staging (working copy)
-- gwz_nps_clean        → cleaned (Silver)
-- gwz_nps_calculated   → enriched with NPS column (Gold)


-- ============================================================
-- STEP 3: NPS SCORE CALCULATION
-- ============================================================

-- Add NPS category column using CASE WHEN
CREATE OR REPLACE TABLE course14.gwz_nps_calculated AS
SELECT
  date_date,
  orders_id,
  transporter,
  sgt,
  global_note,
  CASE
    WHEN global_note BETWEEN 9 AND 10 THEN 1   -- Promoter
    WHEN global_note BETWEEN 7 AND 8  THEN 0   -- Passive
    WHEN global_note BETWEEN 0 AND 6  THEN -1  -- Detractor
    ELSE NULL
  END AS nps,
  csat_website,
  csat_product,
  csat_price,
  csat_delivery
FROM course14.gwz_nps_clean;

-- Count total NPS responses (excluding nulls)
SELECT COUNT(*) AS total_reviews
FROM course14.gwz_nps_calculated
WHERE nps IS NOT NULL;
-- Result: 6253

-- Count promoters
SELECT COUNT(*) AS promoters
FROM course14.gwz_nps_calculated
WHERE nps = 1;
-- Result: 4524

-- Count detractors
SELECT COUNT(*) AS detractors
FROM course14.gwz_nps_calculated
WHERE nps = -1;
-- Result: 459

-- Count passives (validation)
SELECT COUNT(*)
FROM course14.gwz_nps_calculated
WHERE nps = 0;
-- Result: 1270

-- Calculate overall NPS
SELECT ROUND((4524 - 459) / 6253 * 100, 1) AS nps_score;
-- Result: 65.0 ✅


